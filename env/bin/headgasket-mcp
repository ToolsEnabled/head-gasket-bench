#!/usr/bin/env python3
"""Launcher for the Head Gasket Job MCP server and its replay/verify commands.

Equivalent to ``python3 -m headgasket`` run from the environment root.
"""
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
from headgasket.cli import main  # noqa: E402

sys.exit(main())
